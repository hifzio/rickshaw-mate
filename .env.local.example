# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon (or newer "publishable") key. Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional
# Your custom domain once you have one (Vercel's own domain is detected automatically).
# NEXT_PUBLIC_SITE_URL=https://rickshawmate.com
# Shown on /privacy and /terms.
# NEXT_PUBLIC_CONTACT_EMAIL=support@rickshawmate.com
# Set to true to keep the browser-console logs in a production build.
# NEXT_PUBLIC_DEBUG_LOGS=false
